[Unit]
Description=Reconcile durable POG worker finalizations
Wants=network-online.target
Requires=pog-capsule-state.service
After=network-online.target pog-capsule-state.service

[Service]
Type=oneshot
User=pog
Group=pog
WorkingDirectory=/opt/pog/current
Environment=HOME=/var/lib/pog
Environment=XDG_CACHE_HOME=/var/cache/pog
Environment=PATH=/opt/kitsoki-hosted-pog/node/current/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=POG_FEEDBACK_DISPATCH_ROOT=/opt/pog/current
Environment=POG_KITSOKI_BIN=/opt/kitsoki-hosted-pog/current/kitsoki
EnvironmentFile=/etc/kitsoki/queue-worker.env
ExecStart=/bin/bash /opt/pog/current/scripts/feedback-worker-finalizer.sh --project /opt/pog/current
TimeoutStartSec=5min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

