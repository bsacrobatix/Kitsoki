[Unit]
Description=Link stable POG Capsule control-plane state into the active release
After=local-fs.target
Before=pog-portal.service pog-colony-runner.service kitsoki-queue-worker.service

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/kitsoki-hosted-pog-link-capsule-state
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
