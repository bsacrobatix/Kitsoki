[Unit]
Description=Kitsoki authenticated host for the POG portal
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=pog
Group=pog
WorkingDirectory=/opt/pog/current
Environment=HOME=/var/lib/kitsoki-pog
Environment=XDG_CACHE_HOME=/var/cache/kitsoki-pog
# Carries KITSOKI_HOSTED_POG_GH_CLIENT_SECRET, referenced as ${VAR} from the
# rendered hosted-pog.yaml. Root-owned 0600; systemd reads it, not the pog user.
EnvironmentFile=/etc/kitsoki/hosted-pog.env
ExecStart=/opt/kitsoki-hosted-pog/current/kitsoki daemon --config /etc/kitsoki/hosted-pog.yaml --db /var/lib/kitsoki-pog/sessions.db --addr 127.0.0.1:7777 --stories-dir /opt/pog/current/stories --kits-dir /opt/pog/current/kits
Restart=on-failure
RestartSec=3s
TimeoutStopSec=30s
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
StateDirectory=kitsoki-pog
CacheDirectory=kitsoki-pog

[Install]
WantedBy=multi-user.target
