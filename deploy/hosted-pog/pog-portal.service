[Unit]
Description=POG production portal on port 7777
Requires=kitsoki-pog.service pog-capsule-state.service
After=kitsoki-pog.service pog-capsule-state.service
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=pog
Group=pog
WorkingDirectory=/opt/pog/current
Environment=HOME=/var/lib/pog
Environment=XDG_CACHE_HOME=/var/cache/pog
Environment=PATH=/opt/kitsoki-hosted-pog/node/current/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=NODE_ENV=production
Environment=POG_RELEASE_SHA=__POG_RELEASE_SHA__
Environment=POG_PORTAL_ADDR=127.0.0.1:7777
Environment=POG_PORTAL_ROOT=/opt/pog/current/portal
Environment=POG_PORTAL_STATIC_ROOT=/opt/pog/current/portal/dist
Environment=POG_CATALOG=/opt/pog/current/pog/catalog.yaml
Environment=POG_PROJECT_ROOT=/opt/pog/current
# Federation is pinned deterministically (see POG portal/src/server/
# federation-roots.ts). POG_PORTFOLIO_ROOT is the checkout the tracks' repo:
# fields resolve against; POG_MEMBER_ROOTS points each federated sibling at its
# own read-only checkout under /opt/pog/members (install.sh deploys them and
# renders both values). Without these the server falls back to a heuristic that
# finds no siblings on a deployed host and silently drops every member.
Environment=POG_PORTFOLIO_ROOT=/opt/pog/current
Environment=POG_MEMBER_ROOTS=__POG_MEMBER_ROOTS__
Environment=POG_PORTFOLIO_MEMBERS=__POG_PORTFOLIO_MEMBERS__
# The portal launches on-demand delivery children. POG's deterministic gate
# validates the federated gears catalog, so those children need the same
# explicit hosted checkout that the durable queue worker receives.
Environment=POG_GEARS_RUST_SRC=/opt/pog/members/gears-rust
Environment=POG_KITSOKI_URL=http://127.0.0.1:7778
Environment=POG_KITSOKI_BROWSER_URL=
Environment=POG_RUNNER_URL=http://127.0.0.1:7778
Environment=POG_KITSOKI_BIN=/opt/kitsoki-hosted-pog/current/kitsoki
Environment=POG_FEEDBACK_LOCAL_LEDGER=/var/lib/pog/runtime/feedback/feedback.jsonl
Environment=POG_GRAPH_FEEDBACK_LEDGER=/var/lib/pog/runtime/graph-mcp/feedback.jsonl
Environment=POG_FEEDBACK_TRIAGE_LEDGER=/var/lib/pog/runtime/feedback/triage.jsonl
Environment=POG_FEEDBACK_HOSTED_DIR=/var/lib/pog/runtime/feedback/hosted
Environment=POG_FEEDBACK_AUTO_REPRODUCTION_LEDGER=/var/lib/pog/runtime/feedback/auto-reproduction-bindings.json
Environment=POG_FEEDBACK_DECISIONS_LEDGER=/var/lib/pog/runtime/feedback/decisions.jsonl
Environment=POG_FEEDBACK_COMPLETIONS_DIR=/var/lib/pog/runtime/feedback/completions
Environment=POG_AGENT_RUNNER_DB=/var/lib/pog/runtime/agent-runner/sessions.db
Environment=POG_STREAMS_DIR=/var/lib/pog/runtime/streams
ExecStart=/opt/kitsoki-hosted-pog/node/current/bin/node --enable-source-maps /opt/pog/current/portal/server/server.mjs --addr 127.0.0.1:7777 --static /opt/pog/current/portal/dist
Restart=always
RestartSec=3s
TimeoutStopSec=30s
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
StateDirectory=pog
CacheDirectory=pog

[Install]
WantedBy=multi-user.target
