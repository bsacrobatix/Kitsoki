[Unit]
Description=POG portal
Requires=kitsoki-pog.service
After=kitsoki-pog.service

[Service]
Type=simple
User=pog
Group=pog
WorkingDirectory=/opt/pog/current
Environment=HOME=/var/lib/pog
Environment=XDG_CACHE_HOME=/var/cache/pog
Environment=PATH=/opt/kitsoki-hosted-pog/node/current/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=POG_CATALOG=/opt/pog/current/pog/catalog.yaml
Environment=POG_PROJECT_ROOT=/opt/pog/current
Environment=POG_KITSOKI_URL=http://127.0.0.1:7777
Environment=POG_KITSOKI_BROWSER_URL=
Environment=POG_RUNNER_URL=http://127.0.0.1:7777
Environment=POG_KITSOKI_BIN=/opt/kitsoki-hosted-pog/current/kitsoki
Environment=POG_FEEDBACK_LOCAL_LEDGER=/var/lib/pog/feedback/feedback.jsonl
Environment=POG_GRAPH_FEEDBACK_LEDGER=/var/lib/pog/graph-mcp/feedback.jsonl
Environment=POG_FEEDBACK_TRIAGE_LEDGER=/var/lib/pog/feedback/triage.jsonl
Environment=POG_FEEDBACK_HOSTED_DIR=/var/lib/pog/feedback/hosted
Environment=POG_FEEDBACK_AUTO_REPRODUCTION_LEDGER=/var/lib/pog/feedback/auto-reproduction-bindings.json
Environment=POG_FEEDBACK_DECISIONS_LEDGER=/var/lib/pog/feedback/decisions.jsonl
Environment=POG_STREAMS_DIR=/var/lib/pog/streams
ExecStart=/opt/kitsoki-hosted-pog/node/current/bin/npm --prefix /opt/pog/current/portal run dev -- --host 127.0.0.1 --port 5183 --strictPort
Restart=on-failure
RestartSec=3s
TimeoutStopSec=30s
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
StateDirectory=pog
CacheDirectory=pog

[Install]
WantedBy=multi-user.target
