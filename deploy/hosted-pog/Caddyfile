{
	email admin@slothattax.me
	acme_ca https://acme-v02.api.letsencrypt.org/directory
}

(pog_login) {
	request_header -X-Kitsoki-Actor
	forward_auth 127.0.0.1:7778 {
		uri /auth/check
		copy_headers X-Kitsoki-Actor
	}
}

__PUBLIC_HOST__ {
	log {
		output file /var/log/caddy/access.log
	}

	# GitHub login endpoints must remain reachable before a session exists. They
	# expose only the login protocol; Kitsoki validates invite codes, GitHub
	# identity, device attempts, and sessions before creating a browser session.
	handle /auth/* {
		reverse_proxy 127.0.0.1:7778
	}

	# GitHub cannot present a browser session. This is the sole non-login bypass
	# and the GitHub agent rejects every request without a valid HMAC signature.
	handle /gh-agent/webhook {
		reverse_proxy 127.0.0.1:8787
	}

	# Every human-readable or diagnostic agent surface is private too. Health,
	# readiness, run listings, run details, and evidence must not leak merely
	# because they pre-date POG.
	@gh_agent path /healthz /api/ready /api/runs /api/run/* /runs /runs/* /run/*
	handle @gh_agent {
		import pog_login
		reverse_proxy 127.0.0.1:8787
	}
	handle /decks/* {
		import pog_login
		root * /var/lib/kitsoki-gh-agent
		try_files {path} {path}.html
		file_server
	}

	# These are POG-owned surfaces even though their backing services are not
	# the production portal process. They receive the same fail-closed check.
	handle_path /constructor-studio/decks/* {
		import pog_login
		root * /srv/slidey-decks
		file_server
	}
	# The external hosted feedback sink owns only its exact public endpoint.
	# POG's /api/feedback-reports and /api/feedback-autonomy/* routes must fall
	# through to the production portal; a wildcard here made those datasets
	# look as if they had disappeared.
	@hosted_feedback path /api/feedback
	handle @hosted_feedback {
		import pog_login
		reverse_proxy 127.0.0.1:8788
	}

	# POG owns the remaining origin, including its root-relative assets and all
	# production API routes. If Kitsoki auth is unavailable,
	# forward_auth fails closed and this upstream is never reached.
	handle {
		import pog_login
		reverse_proxy 127.0.0.1:7777
	}
}
