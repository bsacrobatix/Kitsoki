{
  "type": "object",
  "additionalProperties": false,
  "required": ["results_url", "parameters", "remote_selected", "bridge_actions"],
  "properties": {
    "results_url": {"type": "string", "minLength": 1, "pattern": "^https://(www\\.)?linkedin\\.com/jobs/"},
    "remote_selected": {"const": true},
    "bridge_actions": {
      "type": "array",
      "items": {"type": "string", "enum": ["navigate", "select_remote", "snapshot"]},
      "minItems": 3,
      "maxItems": 3,
      "allOf": [
        {"contains": {"const": "navigate"}},
        {"contains": {"const": "select_remote"}},
        {"contains": {"const": "snapshot"}}
      ]
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keywords", "location"],
      "properties": {
        "keywords": {"type": "string", "minLength": 1},
        "location": {"type": "string"}
      }
    }
  }
}
