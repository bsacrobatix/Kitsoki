{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["passed", "summary", "trace_ref"],
  "properties": {
    "passed": { "type": "boolean" },
    "summary": { "type": "string", "minLength": 1 },
    "trace_ref": { "type": "string", "minLength": 1 },
    "bundle_ref": { "type": "string", "minLength": 1 },
    "bundle_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "bundle_kind": { "type": "string", "const": "git-bundle" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "passed": { "const": true } },
        "required": ["passed"]
      },
      "then": {
        "required": ["bundle_ref", "bundle_digest", "bundle_kind"]
      }
    }
  ]
}
