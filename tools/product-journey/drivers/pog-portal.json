{
  "id": "pog-portal",
  "label": "POG portal via local browser-mcp (Playwright + Stagehand)",
  "app_kind": "web",
  "launch": {
    "ready": {
      "http": "http://127.0.0.1:5183/",
      "timeout_s": 30
    }
  },
  "capabilities": {
    "visual.open": [
      "mcp__browser__browser_navigate"
    ],
    "visual.observe": [
      "mcp__browser__browser_snapshot",
      "mcp__browser__browser_find",
      "mcp__browser__observe"
    ],
    "visual.act": [
      "mcp__browser__browser_click",
      "mcp__browser__browser_fill",
      "mcp__browser__browser_press",
      "mcp__browser__browser_scroll",
      "mcp__browser__browser_batch",
      "mcp__browser__act"
    ],
    "session.open": [
      "mcp__browser__browser_navigate"
    ],
    "session.status": [
      "mcp__browser__browser_snapshot"
    ],
    "session.submit": [
      "mcp__browser__browser_click",
      "mcp__browser__browser_press"
    ],
    "session.drive": [
      "mcp__browser__browser_click",
      "mcp__browser__browser_fill",
      "mcp__browser__browser_press",
      "mcp__browser__browser_batch"
    ],
    "session.inspect": [
      "mcp__browser__browser_snapshot",
      "mcp__browser__browser_find"
    ],
    "session.trace": [
      "mcp__browser__browser_snapshot"
    ],
    "render.tui": [
      "mcp__browser__browser_snapshot"
    ]
  },
  "affordances": {
    "portal-page": "[data-testid=pog-portal-page]",
    "reload": "[data-testid=app-reload]",
    "open-market-research": "[data-testid=app-open-market-research]",
